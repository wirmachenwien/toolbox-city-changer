---
// Project page layout: home, search.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import OpenerImage from '../components/OpenerImage.astro';
import LastVisit from '../components/LastVisit.astro';
import { pageCrumbs } from '../lib/nav';
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
  file: string;
  title: string;
  description?: string;
  layout: 'home' | 'page' | 'search';
  currentUrl: string;
  openerImage?: string;
  openerImageAlt?: string;
}

const { lang, file, title, description, layout, currentUrl, openerImage, openerImageAlt } = Astro.props;
// The frontmatter title bypasses the markdown pipeline, so quotes are
// localised once here and reused below.
const displayTitle = smartQuotes(title, lang);
const crumbs = pageCrumbs(lang, displayTitle);
const isHome = layout === 'home';
---
<BaseLayout
  lang={lang}
  title={title}
  description={description}
  kind="page"
  file={file}
  currentUrl={currentUrl}
>
  {!isHome && <Breadcrumbs items={crumbs} lang={lang} />}
  {isHome && openerImage && <OpenerImage file={openerImage} alt={openerImageAlt ?? ''} lang={lang} />}
  <div class="prose" data-prose>
    <slot />
  </div>
  {isHome && <LastVisit lang={lang} />}
</BaseLayout>
