---
// Localised select dropdown that reveals linked content on change
// (progressive enhancement over a plain list of links in noscript).
import { t } from '../lib/i18n';
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';

export interface SelectOption {
  label: string;
  href: string;
}

interface Props {
  id: string;
  label?: string;
  options: SelectOption[];
  lang?: Language;
}

const { id, label, options, lang = 'en' } = Astro.props;
// Author-supplied labels bypass the markdown pipeline, so quotes are
// localised here to match the hast-transformed prose.
const prompt = label ? smartQuotes(label, lang) : t(lang, 'controls.choose-chapter', 'Choose chapter…');
const displayOptions = options.map((option) => ({ ...option, label: smartQuotes(option.label, lang) }));
---
<div class="select-list" data-select-list>
  <label for={id}>{prompt}</label>
  <select id={id} data-select>
    {displayOptions.map((option) => (
      <option value={option.href}>{option.label}</option>
    ))}
  </select>
  <noscript>
    <ul>
      {displayOptions.map((option) => (
        <li><a href={option.href}>{option.label}</a></li>
      ))}
    </ul>
  </noscript>
</div>
