---
// Privacy-friendly video embed: renders a click-to-load facade and only
// touches the provider once the reader presses play.
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';

interface Props {
  id: string;
  caption?: string;
  provider?: 'youtube' | 'vimeo';
  lang?: Language;
}

const { id, caption, provider = 'youtube', lang = 'de' } = Astro.props;

const watchUrl =
  provider === 'vimeo' ? `https://vimeo.com/${id}` : `https://www.youtube.com/watch?v=${id}`;
const embedUrl =
  provider === 'vimeo'
    ? `https://player.vimeo.com/video/${id}?autoplay=1`
    : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
const poster =
  provider === 'vimeo' ? undefined : `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<figure class="video-facade" data-video data-embed={embedUrl}>
  <button
    type="button"
    data-play
    style={poster ? `background-image: url(${poster})` : undefined}
    aria-label={`${t(lang, 'video.play-video', 'Play video')}${caption ? `: ${caption}` : ''}`}
  >
    <span class="play">▶ {t(lang, 'video.play-video', 'Play video')}</span>
  </button>
  <noscript>
    <a href={watchUrl}>{t(lang, 'video.play-video', 'Play video')}</a>
  </noscript>
  {caption && <figcaption class="video-caption">{caption}</figcaption>}
</figure>
