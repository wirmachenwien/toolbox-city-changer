---
 // Share links. Networks come from the locale strings; every network present
 // in the locale is rendered (commenting one out of the locale removes it).
import { t } from '../lib/i18n';
import { canonical } from '../lib/site';
import type { Language } from '../data/locales';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  lang: Language;
  url: string;
  title: string;
}

const { lang, url, title } = Astro.props;
const absolute = canonical(url);
const networks: { key: string; icon: IconName; href: string }[] = [
  { key: 'link', icon: 'link', href: absolute },
  { key: 'email', icon: 'mail', href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(absolute)}` },
  { key: 'bluesky', icon: 'bluesky', href: `https://bsky.app/intent/compose?text=${encodeURIComponent(`${title} ${absolute}`)}` },
  { key: 'facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(absolute)}` },
  { key: 'linkedin', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(absolute)}` },
  { key: 'reddit', icon: 'reddit', href: `https://www.reddit.com/submit?url=${encodeURIComponent(absolute)}&title=${encodeURIComponent(title)}` },
  { key: 'twitter', icon: 'x', href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(absolute)}&text=${encodeURIComponent(title)}` },
  { key: 'whatsapp', icon: 'whatsapp', href: `https://wa.me/?text=${encodeURIComponent(`${title} ${absolute}`)}` },
];
const available = networks.filter((network) => t(lang, `share.${network.key}`, '') !== '');
---
<div class="share" data-share>
  <span>{t(lang, 'share.share', 'Share')}:</span>
  <ul>
    {available.map((network) =>
      network.key === 'link' ? (
        <li>
          <button
            type="button"
            class="share-btn"
            data-copy={absolute}
            data-copy-label={t(lang, 'share.link', 'Link')}
            data-copied-label={t(lang, 'copy.copied', 'Copied')}
            data-failed-label={t(lang, 'copy.copy-failed', 'Sorry, try again')}
          >
            <Icon name={network.icon} />
            {t(lang, 'share.link', 'Link')}
          </button>
        </li>
      ) : (
        <li>
          <a href={network.href} target="_blank" rel="noopener noreferrer">
            <Icon name={network.icon} />
            {t(lang, `share.${network.key}`, network.key)}
          </a>
        </li>
      ),
    )}
  </ul>
</div>
