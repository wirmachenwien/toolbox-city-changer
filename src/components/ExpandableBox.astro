---
// Expandable "read more" box, also native <details>.
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';

interface Props {
  title?: string;
  lang?: Language;
}
const { title, lang = 'en' } = Astro.props;
---
<details class="expandable">
  <summary>{title ?? t(lang, 'expandable-box.read-more', 'Expand')}</summary>
  <div class="expandable-body">
    <slot />
  </div>
</details>
