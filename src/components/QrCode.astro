---
// QR code for the current page URL, rendered server-side as inline SVG
// (no runtime dependency, works offline and in print).
import QRCode from 'qrcode';
import { canonical } from '../lib/site';
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';

interface Props {
  url: string;
  label?: string;
  size?: number;
  lang?: Language;
}

const { url, label, size = 160, lang } = Astro.props;
// Author-supplied labels bypass the markdown pipeline, so quotes are
// localised here to match the hast-transformed prose (only when lang is
// known). The URL itself is never rewritten.
const displayLabel = label && lang ? smartQuotes(label, lang) : label;
const svg = await QRCode.toString(canonical(url), { type: 'svg', width: size, margin: 1 });
---
<figure class="qr">
  <div set:html={svg} role="img" aria-label={displayLabel ?? url} />
  {displayLabel && <figcaption>{displayLabel}</figcaption>}
</figure>
