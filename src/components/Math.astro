---
// Mathematics (TeX). Loads the MathJax runtime from the configured source
// (settings.math.source: "cdn" | "local") only on pages that use this
// component, then typesets the slot content.
import { settings } from '../data/settings';
import { withBase } from '../lib/site';

interface Props {
  display?: boolean;
}
const { display = false } = Astro.props;
const src =
  settings.math.source === 'local'
    ? withBase('/vendor/mathjax/tex-chtml.js')
    : 'https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js';
---
{settings.math.enabled && (
  <>
    <span class="math" data-display={display ? 'true' : 'false'}><slot /></span>
    <script src={src} async data-mathjax />
  </>
)}
