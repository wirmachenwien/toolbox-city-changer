---
import DownloadLink from './DownloadLink.astro';
import { downloadEnabled } from '../lib/downloads';

interface Link {
  href: string;
  label: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
const visibleLinks = links.filter((link) => downloadEnabled(link.href));
---
{visibleLinks.length > 0 && (
  <div class="download-buttons">
    {visibleLinks.map((link) => <DownloadLink href={link.href}>{link.label}</DownloadLink>)}
  </div>
)}
