---
// Site footer: credit line, Impressum link, reuse note, language dropdown.
import { project } from '../data/project';
import { projectText, t } from '../lib/i18n';
import { bookUrl } from '../lib/site';
import type { Language } from '../data/locales';
import LanguageMenu from './LanguageMenu.astro';

interface Props {
  lang: Language;
  kind: 'page' | 'book';
  file: string;
}

const { lang, kind, file } = Astro.props;
const text = projectText(lang);
const credit = `${text.credit || project.credit} <a href="https://wirmachen.wien/impressum/">Impressum</a>`;
const reuse = t(lang, 'footer.reuse', '').replace('{about}', bookUrl(lang, '0-2-about'));
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-text">
      <p set:html={credit} />
      {reuse && <p set:html={reuse} />}
    </div>
    <LanguageMenu lang={lang} kind={kind} file={file} id="foot-language" />
  </div>
</footer>
