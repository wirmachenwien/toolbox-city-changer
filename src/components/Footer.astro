---
// Site footer: credit line and language dropdown.
import { projectText } from '../lib/i18n';
import type { Language } from '../data/locales';
import LanguageMenu from './LanguageMenu.astro';

interface Props {
  lang: Language;
  kind: 'page' | 'book';
  file: string;
}

const { lang, kind, file } = Astro.props;
// The entire footer line is a single HTML string (project credit per
// language, falling back to the default project metadata).
const credit = projectText(lang).credit;
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-text">
      <p set:html={credit} />
    </div>
    <LanguageMenu lang={lang} kind={kind} file={file} id="foot-language" />
  </div>
</footer>
