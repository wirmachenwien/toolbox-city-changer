---
// Single-question check (radio group): one correct answer. Marks come from
// the embedded icon templates, cloned by the client quiz script.
import { t } from '../lib/i18n';
import Icon from './Icon.astro';
import type { Language } from '../data/locales';

interface Props {
  id: string;
  question: string;
  options: string[];
  answer: number;
  lang?: Language;
  feedbackCorrect?: string;
  feedbackIncorrect?: string;
}

const { id, question, options, answer, lang = 'en', feedbackCorrect, feedbackIncorrect } = Astro.props;
---
<form
  class="quiz"
  data-quiz={id}
  data-single="true"
  data-feedback-correct={feedbackCorrect ?? t(lang, 'questions.feedback-correct', 'Correct!')}
  data-feedback-incorrect={feedbackIncorrect ?? t(lang, 'questions.feedback-incorrect', 'Incorrect')}
>
  <fieldset>
    <legend>{question}</legend>
    {options.map((option, index) => (
      <label>
        <input
          type="radio"
          name={id}
          value={String(index)}
          data-correct={index === answer ? 'true' : undefined}
        />
        <span>{option}</span>
      </label>
    ))}
  </fieldset>
  <template data-icon-correct><Icon name="check" /></template>
  <template data-icon-incorrect><Icon name="x" /></template>
  <p class="quiz-feedback" data-feedback aria-live="polite" />
  <button type="submit">{t(lang, 'questions.check-answers-button', 'Check my answers')}</button>
</form>
