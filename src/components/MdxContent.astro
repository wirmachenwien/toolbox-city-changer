---
// Shared MDX renderer: renders a content-collection entry with the project
// component scope (all author-usable content components; chrome like
// Masthead, SideNav, Footer, Breadcrumbs, Pagination stays in the layouts).
import { render, type CollectionEntry } from 'astro:content';
import Figure from './Figure.astro';
import Video from './Video.astro';
import ButtonLink from './ButtonLink.astro';
import DownloadLink from './DownloadLink.astro';
import SideBySideButtons from './SideBySideButtons.astro';
import CopyText from './CopyText.astro';
import Toc from './Toc.astro';
import CcBadge from './CcBadge.astro';
import FeatureBox from './FeatureBox.astro';
import PullQuote from './PullQuote.astro';
import TableWrap from './TableWrap.astro';
import Glossary from './Glossary.astro';
import Quiz from './Quiz.astro';
import Question from './Question.astro';
import Footnote from './Footnote.astro';
import Spoiler from './Spoiler.astro';
import Accordion from './Accordion.astro';
import ExpandableBox from './ExpandableBox.astro';
import Slideshow from './Slideshow.astro';
import Bibliography from './Bibliography.astro';
import ColorPanel from './ColorPanel.astro';
import DefinitionTerm from './DefinitionTerm.astro';
import PageRef from './PageRef.astro';
import SelectList from './SelectList.astro';

interface Props {
  entry: CollectionEntry<'book'> | CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Content components={{ Figure, Video, ButtonLink, DownloadLink, SideBySideButtons, CopyText, Toc, CcBadge, FeatureBox, PullQuote, TableWrap, Glossary, Quiz, Question, Footnote, Spoiler, Accordion, ExpandableBox, Slideshow, Bibliography, ColorPanel, DefinitionTerm, PageRef, SelectList }} />
