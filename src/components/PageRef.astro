---
// Cross-reference to another book page, with the localised page-wording.
import { t } from '../lib/i18n';
import { bookUrl } from '../lib/site';
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
  file: string;
  label: string;
  page?: string;
}
const { lang, file, label, page } = Astro.props;
---
<a href={bookUrl(lang, file)}>
  {label}{page && ` ${t(lang, 'cross-references.pre-page-number', '(page ')}${page}${t(lang, 'cross-references.post-page-number', ')')}`}
</a>
