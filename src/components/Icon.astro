---
 // Inline SVG icon set (decorative; always aria-hidden, labels stay as text).
 // Stroke icons follow a 24x24 feather-style grid, brand icons are filled.
export type IconName =
  | 'search'
  | 'globe'
  | 'menu'
  | 'link'
  | 'mail'
  | 'bookmark'
  | 'download'
  | 'check'
  | 'bluesky'
  | 'facebook'
  | 'linkedin'
  | 'reddit'
  | 'x'
  | 'whatsapp';

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---
{name === 'search' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
)}
{name === 'globe' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
)}
{name === 'menu' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
)}
{name === 'link' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
)}
{name === 'mail' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
)}
{name === 'bookmark' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg>
)}
{name === 'download' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
)}
{name === 'check' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
)}
{name === 'facebook' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
)}
{name === 'linkedin' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><circle cx="4.5" cy="4.5" r="2" /><rect x="3" y="9" width="3" height="12" rx="0.5" /><path d="M10 21v-6.8c0-1.9.9-3 2.5-3 1.5 0 2.3 1 2.6 2.1.1.4.1.9.1 1.4V21h3v-7.1c0-3-1.5-4.9-4.3-4.9-1.7 0-2.9.8-3.5 1.9V9h-3v12z" /></svg>
)}
{name === 'x' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 4l16 16" /><path d="M20 4L4 20" /></svg>
)}
{name === 'whatsapp' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /><path d="M9 9.5c.5 2.5 3 5 5.5 5.5l1-1.5 2 1c-.5 1.5-1 2-2 1.5-3.5-1.5-6.5-4.5-8-8-.5-1 .5-1.5 1.5-2l1 2z" /></svg>
)}
{name === 'bluesky' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 11.3C10.2 8 7 6.2 4.2 7c-1.4.4-1.4 1.9-.4 3.9 1 2.4 2.9 3.9 4.4 4.9-.5 1.5-.9 3.4.1 4.9 1.9-1 3.3-3.4 3.7-5.1.4 1.7 1.8 4.1 3.7 5.1 1-1.5.6-3.4.1-4.9 1.5-1 3.4-2.5 4.4-4.9 1-2 1-3.5-.4-3.9-2.8-.8-6 1-7.8 4.3z" /></svg>
)}
{name === 'reddit' && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="7" /><circle cx="9.5" cy="13" r="0.5" fill="currentColor" /><circle cx="14.5" cy="13" r="0.5" fill="currentColor" /><path d="M9 16.5c1 1 2 1.5 3 1.5s2-.5 3-1.5" /><path d="M12 7V4" /><path d="M12 4l4-2" /><circle cx="17.5" cy="1.8" r="1" fill="currentColor" stroke="none" /></svg>
)}
