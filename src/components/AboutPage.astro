---
// Über/About sheet: heading only (the page title, same string as the
// document title). The CC BY badge lives in the print/PDF pipeline.
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';

interface Props {
  title: string;
  lang?: Language;
}
const { title, lang } = Astro.props;
// Titles bypass the markdown pipeline, so quotes are localised here to
// match the hast-transformed prose (only when lang is known).
const displayTitle = lang ? smartQuotes(title, lang) : title;
---
<div class="sheet about-sheet">
  <h1>{displayTitle}</h1>
</div>
