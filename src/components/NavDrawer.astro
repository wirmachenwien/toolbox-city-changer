---
// Slide-over navigation: project links plus the expandable book index.
// The sheet covers the sticky masthead when open; the floating toggle below
// sits at the exact spot of the header hamburger (which ends up behind the
// sheet in its own stacking context) and doubles as the close control. It
// lives at body level with position: fixed so it stays pinned while the
// sheet slides in underneath it — preserving the same-button illusion.
// Both toggles share data-drawer-toggle so drawer.ts keeps them in sync.
import { combinedNav } from '../lib/nav';
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';
import Icon from './Icon.astro';

interface Props {
  lang: Language;
  currentUrl: string;
}

const { lang, currentUrl } = Astro.props;
const { project: projectLinks, book, position } = combinedNav(lang, currentUrl);

const sections =
  position === 'before'
    ? [
        { heading: null as string | null, links: projectLinks },
        { heading: t(lang, 'nav.toc', 'Contents'), links: book },
      ]
    : [
        { heading: t(lang, 'nav.toc', 'Contents'), links: book },
        { heading: null as string | null, links: projectLinks },
      ];
---
<div class="drawer" data-drawer role="dialog" aria-modal="true" aria-label={t(lang, 'nav.menu', 'Menu')} tabindex="-1" hidden>
  <div class="drawer-inner">
    {sections.map(
      (section) =>
        section.links.length > 0 && (
          <section class="nav-section">
            {section.heading && <h2>{section.heading}</h2>}
            <ul class="nav-list">
              {section.links.map((link) => (
                <li>
                  <a href={link.url} aria-current={link.current ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ),
    )}
  </div>
</div>
<div class="drawer-backdrop" data-drawer-backdrop hidden></div>
<button type="button" class="menu-toggle drawer-toggle-float" data-drawer-toggle aria-expanded="false" aria-label={t(lang, 'input.close', 'Close')}>
  <span class="menu-icon"><Icon name="menu" /></span>
  <span class="menu-icon menu-icon--close"><Icon name="x" /></span>
  <span class="menu-label">{t(lang, 'input.close', 'Close')}</span>
</button>
