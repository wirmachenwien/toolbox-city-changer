---
// Copy-to-clipboard button. Locale strings travel via data attributes;
// src/scripts/copy.ts wires every [data-copy] button on the page.
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';

interface Props {
  value: string;
  lang: Language;
}

const { value, lang } = Astro.props;
---
<button
  type="button"
  class="copy-btn"
  data-copy={value}
  data-copy-label={t(lang, 'copy.copy', 'Copy')}
  data-copied-label={t(lang, 'copy.copied', 'Copied')}
  data-failed-label={t(lang, 'copy.copy-failed', 'Sorry, try again')}
>
  {t(lang, 'copy.copy', 'Copy')}
</button>
