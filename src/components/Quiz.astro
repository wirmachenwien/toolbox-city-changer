---
// Self-grading multiple-choice quiz. Options are declared in markup; the
// client script grades against data-correct and reads feedback strings
// from data attributes (localised at render time).
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';

export interface QuizOption {
  label: string;
  correct?: boolean;
}

interface Props {
  id: string;
  question: string;
  options: QuizOption[];
  lang?: Language;
}

const { id, question, options, lang = 'de' } = Astro.props;
---
<form
  class="quiz"
  data-quiz={id}
  data-feedback-correct={t(lang, 'questions.feedback-correct', 'Correct!')}
  data-feedback-incorrect={t(lang, 'questions.feedback-incorrect', 'Incorrect')}
  data-feedback-unfinished={t(lang, 'questions.feedback-unfinished', "You haven't selected all the correct answers.")}
  data-mark-correct={t(lang, 'questions.mark-correct', '✓')}
  data-mark-incorrect={t(lang, 'questions.mark-incorrect', '✗')}
>
  <fieldset>
    <legend>{question}</legend>
    {options.map((option, index) => (
      <label>
        <input
          type="checkbox"
          name={`${id}-${index}`}
          value={String(index)}
          data-correct={option.correct ? 'true' : undefined}
        />
        <span>{option.label}</span>
      </label>
    ))}
  </fieldset>
  <p class="quiz-feedback" data-feedback aria-live="polite" />
  <button type="submit">{t(lang, 'questions.check-answers-button', 'Check my answers')}</button>
</form>
