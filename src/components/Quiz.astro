---
// Self-grading multiple-choice quiz. Options are declared in markup; the
// client script grades against data-correct, reads feedback strings from
// data attributes (localised at render time) and clones the embedded icon
// templates as per-option marks.
import { t } from '../lib/i18n';
import { smartQuotes } from '../lib/smart-quotes';
import Icon from './Icon.astro';
import type { Language } from '../data/locales';

export interface QuizOption {
  label: string;
  correct?: boolean;
}

interface Props {
  id: string;
  question: string;
  options: QuizOption[];
  lang?: Language;
  feedbackCorrect?: string;
  feedbackIncorrect?: string;
  feedbackUnfinished?: string;
}

const { id, question, options, lang = 'en', feedbackCorrect, feedbackIncorrect, feedbackUnfinished } = Astro.props;
// Author-supplied display strings bypass the markdown pipeline, so quotes
// are localised here to match the hast-transformed prose.
const displayQuestion = smartQuotes(question, lang);
const displayOptions = options.map((option) => ({ ...option, label: smartQuotes(option.label, lang) }));
---
<form
  class="quiz"
  data-quiz={id}
  data-feedback-correct={smartQuotes(feedbackCorrect ?? t(lang, 'questions.feedback-correct', 'Correct!'), lang)}
  data-feedback-incorrect={smartQuotes(feedbackIncorrect ?? t(lang, 'questions.feedback-incorrect', 'Incorrect'), lang)}
  data-feedback-unfinished={smartQuotes(feedbackUnfinished ?? t(lang, 'questions.feedback-unfinished', "You haven't selected all the correct answers."), lang)}
>
  <fieldset>
    <legend>{displayQuestion}</legend>
    {displayOptions.map((option, index) => (
      <label>
        <input
          type="checkbox"
          name={`${id}-${index}`}
          value={String(index)}
          data-correct={option.correct ? 'true' : undefined}
        />
        <span>{option.label}</span>
      </label>
    ))}
  </fieldset>
  <template data-icon-correct><Icon name="check" /></template>
  <template data-icon-incorrect><Icon name="x" /></template>
  <p class="quiz-feedback" data-feedback aria-live="polite" />
  <button type="submit">{t(lang, 'questions.check-answers-button', 'Check my answers')}</button>
</form>
