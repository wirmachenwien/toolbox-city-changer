---
 // Compact language dropdown for the masthead: globe icon plus a native
 // select that navigates on change (wired by the shared select enhancer).
 // The full link list in the footer stays the no-JS fallback.
import { alternates } from '../lib/site';
import { locales } from '../data/locales';
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';
import Icon from './Icon.astro';

interface Props {
  lang: Language;
  kind: 'page' | 'book';
  file: string;
  id?: string;
}

const { lang, kind, file, id = 'head-language' } = Astro.props;
const targets = alternates(kind, file);
---
<span class="lang-menu" data-select-list>
  <label class="visually-hidden" for={id}>
    {t(lang, 'controls.language-select', 'Select language')}
  </label>
  <Icon name="globe" />
  <select id={id} data-select>
    {targets.map((target) => (
      <option value={target.url} selected={target.lang === lang || undefined}>
        {(locales[target.lang] as { 'local-name'?: string })['local-name'] ?? target.lang}
      </option>
    ))}
  </select>
  <noscript>
    <a href={targets.find((target) => target.lang !== lang)?.url}>
      {t(lang, 'controls.language-select', 'Select language')}
    </a>
  </noscript>
</span>
