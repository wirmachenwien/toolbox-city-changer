---
// Non-default language home pages (/de/, /sl/, ...): the default language
// lives at /. (Collection ids strip the "/index" suffix, so the entry id
// for src/content/pages/<lang>/index.mdx is just "<lang>".)
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import MdxContent from '../../components/MdxContent.astro';
import { defaultLang, languages } from '../../../handbook.config.ts';
import type { Language } from '../../data/locales';
import { pageUrl } from '../../lib/site';

export async function getStaticPaths() {
  return languages
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const language = Astro.params.lang as Language;
const entries = await getCollection('pages');
const entry = entries.find((item) => item.id === language);
if (!entry) throw new Error(`Missing ${language} home page`);
---
<PageLayout
  lang={language}
  file="index"
  title={entry.data.title}
  description={entry.data.description}
  layout="home"
  currentUrl={pageUrl(language, 'index')}
  openerImage={entry.data.openerImage}
  openerImageAlt={entry.data.openerImageAlt}
>
  <MdxContent entry={entry} />
</PageLayout>
