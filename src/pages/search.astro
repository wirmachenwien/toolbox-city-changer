---
// Default-language search (/search.html): static form plus client-side
// Pagefind UI. The page has no MDX source file; its title comes from the
// locale strings.
import PageLayout from '../layouts/PageLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import { t } from '../lib/i18n';
import { pageUrl } from '../lib/site';
import { defaultLang } from '../../handbook.config.ts';

const title = t(defaultLang, 'search.search-title', 'Search');
const url = pageUrl(defaultLang, 'search');
const query = Astro.url.searchParams.get('query') ?? '';
---
<PageLayout lang={defaultLang} file="search" title={title} layout="search" currentUrl={url}>
  <h1>{title}</h1>
  <SearchForm lang={defaultLang} query={query} />
  <p data-search-status aria-live="polite" />
  <ol class="search-results" data-search-results />
</PageLayout>
<script define:vars={{ lang: defaultLang }}>
  import { initSearchUI } from '../scripts/search-ui';
  void initSearchUI(lang);
</script>
