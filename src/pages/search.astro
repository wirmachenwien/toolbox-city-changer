---
// English search (default language): /search.html — static form plus client-side Pagefind UI.
// The page has no MDX source file; its title comes from the locale strings.
import PageLayout from '../layouts/PageLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import { t } from '../lib/i18n';
import { pageUrl } from '../lib/site';

const title = t('en', 'search.search-title', 'Search');
const url = pageUrl('en', 'search');
---
<PageLayout lang="en" file="search" title={title} layout="search" currentUrl={url}>
  <h1>{title}</h1>
  <SearchForm lang="en" />
  <p data-search-status aria-live="polite" />
  <ol class="search-results" data-search-results />
</PageLayout>
<script>
  import { initSearchUI } from '../scripts/search-ui';
  void initSearchUI('en');
</script>
