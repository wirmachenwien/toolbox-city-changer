---
// German project pages: /contact.html (and / via index).
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import MdxContent from '../components/MdxContent.astro';
import { pageUrl } from '../lib/site';

export async function getStaticPaths() {
  return ['index', 'contact'].map((name) => ({ params: { slug: name === 'index' ? undefined : name } }));
  // NOTE: collection ids strip the "/index" suffix (id "de" == de/index.mdx).
}

const { slug } = Astro.params;
const name = slug ?? 'index';
const entries = await getCollection('pages');
const entry = entries.find((item) => item.id === (name === 'index' ? 'de' : `de/${name}`));
if (!entry) throw new Error(`Missing German page: ${name}`);
const url = pageUrl('de', name);
---
<PageLayout
  lang="de"
  file={name}
  title={entry.data.title}
  description={entry.data.description}
  layout={entry.data.template === 'search' ? 'search' : entry.data.template === 'home' ? 'home' : 'page'}
  currentUrl={url}
  openerImage={entry.data.openerImage}
  openerImageAlt={entry.data.openerImageAlt}
>
  <MdxContent entry={entry} />
</PageLayout>
