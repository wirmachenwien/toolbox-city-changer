---
// English project pages (default language, no prefix): / via index.
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import MdxContent from '../components/MdxContent.astro';
import { pageUrl } from '../lib/site';

export async function getStaticPaths() {
  return ['index'].map((name) => ({ params: { slug: name === 'index' ? undefined : name } }));
  // NOTE: collection ids strip the "/index" suffix (id "en" == en/index.mdx).
}

const { slug } = Astro.params;
const name = slug ?? 'index';
const entries = await getCollection('pages');
const entry = entries.find((item) => item.id === (name === 'index' ? 'en' : `en/${name}`));
if (!entry) throw new Error(`Missing English page: ${name}`);
const url = pageUrl('en', name);
---
<PageLayout
  lang="en"
  file={name}
  title={entry.data.title}
  description={entry.data.description}
  layout={entry.data.template === 'search' ? 'search' : entry.data.template === 'home' ? 'home' : 'page'}
  currentUrl={url}
  openerImage={entry.data.openerImage}
  openerImageAlt={entry.data.openerImageAlt}
>
  <MdxContent entry={entry} />
</PageLayout>
