---
// Slovene search: /sl/search.html
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import SearchForm from '../../components/SearchForm.astro';
import MdxContent from '../../components/MdxContent.astro';
import { pageUrl } from '../../lib/site';

const entries = await getCollection('pages');
const entry = entries.find((item) => item.id === 'sl/search');
if (!entry) throw new Error('Missing Slovene search page');
const url = pageUrl('sl', 'search');
---
<PageLayout lang="sl" file="search" title={entry.data.title} layout="search" currentUrl={url}>
  <MdxContent entry={entry} />
  <SearchForm lang="sl" />
  <p data-search-status aria-live="polite" />
  <ol class="search-results" data-search-results />
</PageLayout>
<script>
  import { initSearchUI } from '../../scripts/search-ui';
  void initSearchUI('sl');
</script>
