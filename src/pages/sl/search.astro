---
// Slovene search: /sl/search.html — no MDX source file; the title comes from
// the locale strings.
import PageLayout from '../../layouts/PageLayout.astro';
import SearchForm from '../../components/SearchForm.astro';
import { t } from '../../lib/i18n';
import { pageUrl } from '../../lib/site';

const title = t('sl', 'search.search-title', 'Search');
const url = pageUrl('sl', 'search');
const query = Astro.url.searchParams.get('query') ?? '';
---
<PageLayout lang="sl" file="search" title={title} layout="search" currentUrl={url}>
  <h1>{title}</h1>
  <SearchForm lang="sl" query={query} />
  <p data-search-status aria-live="polite" />
  <ol class="search-results" data-search-results />
</PageLayout>
<script>
  import { initSearchUI } from '../../scripts/search-ui';
  void initSearchUI('sl');
</script>
