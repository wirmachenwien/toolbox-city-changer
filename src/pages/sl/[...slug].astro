---
// Slovene project pages: /sl/, /sl/contact.html.
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import MdxContent from '../../components/MdxContent.astro';
import { pageUrl } from '../../lib/site';

export async function getStaticPaths() {
  return ['contact'].map((name) => ({ params: { slug: name } }));
  // NOTE: collection ids strip the "/index" suffix (id "de" == de/index.mdx).
}

const { slug } = Astro.params;
const name = slug ?? 'index';
const entries = await getCollection('pages');
const entry = entries.find((item) => item.id === (name === 'index' ? 'sl' : `sl/${name}`));
if (!entry) throw new Error(`Missing Slovene page: ${name}`);
const url = pageUrl('sl', name);
---
<PageLayout
  lang="sl"
  file={name}
  title={entry.data.title}
  description={entry.data.description}
  layout={entry.data.template === 'search' ? 'search' : entry.data.template === 'home' ? 'home' : 'page'}
  currentUrl={url}
  openerImage={entry.data.openerImage}
  openerImageAlt={entry.data.openerImageAlt}
>
  <MdxContent entry={entry} />
</PageLayout>
