---
import { getEntry } from 'astro:content';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import MdxContent from '../../components/MdxContent.astro';

const entry = await getEntry('preview', 'component-showcase');
if (!entry) throw new Error('Missing preview page: component-showcase');
---
<PreviewLayout lang={entry.data.lang} title={entry.data.title}>
  <MdxContent entry={entry} />
</PreviewLayout>
