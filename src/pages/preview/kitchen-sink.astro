---
import { getEntry } from 'astro:content';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import MdxContent from '../../components/MdxContent.astro';

const entry = await getEntry('preview', 'kitchen-sink');
if (!entry) throw new Error('Missing preview page: kitchen-sink');
---
<PreviewLayout title={entry.data.title}>
  <MdxContent entry={entry} />
</PreviewLayout>
