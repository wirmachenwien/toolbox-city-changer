---
// Fallback page for unknown URLs (GitHub Pages serves dist/404.html).
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---
<BaseLayout lang="en" title="Page not found" kind="page" file="index" currentUrl={withBase('/404.html')} noindex hreflang={false}>
  <div class="prose">
    <h1>Page not found</h1>
    <p>
      <a href={withBase('/')}>Home</a>
      {' · '}
      <a href={withBase('/de/')}>Start</a>
      {' · '}
      <a href={withBase('/sl/')}>Domov</a>
    </p>
  </div>
</BaseLayout>
