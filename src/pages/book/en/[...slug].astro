---
// Legacy prefixed English book pages (/book/en/<slug>): the English book now
// lives at /book/, so each page redirects to its canonical URL.
import { getCollection } from 'astro:content';
import { WEB_EXCLUDED_FILES } from '../../../data/works';
import { alternates, bookUrl, canonical } from '../../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('book');
  return entries
    .filter((entry) => entry.id.startsWith('en/'))
    .map((entry) => entry.id.slice(3))
    .filter((slug) => !WEB_EXCLUDED_FILES.includes(slug))
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const file = slug ?? 'index';
const target = bookUrl('en', file);
const alternateLinks = alternates('book', file);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical(target)} />
    {alternateLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={canonical(entry.url)} />
    ))}
    <title>Redirect</title>
  </head>
  <body>
    <p><a href={target}>Continue</a></p>
  </body>
</html>
