---
 // Legacy English book landing (/book/en/): the English book now lives at
 // /book/, so redirect to the contents page there.
import { alternates, bookUrl, canonical } from '../../../lib/site';

const target = bookUrl('en', '0-3-contents');
const alternateLinks = alternates('book', 'index');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical(target)} />
    {alternateLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={canonical(entry.url)} />
    ))}
    <title>Contents</title>
  </head>
  <body>
    <p><a href={target}>Contents</a></p>
  </body>
</html>
