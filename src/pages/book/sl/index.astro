---
 // Slovene book landing: /book/sl/ redirects to the contents page since the
 // print-only cover/title sheets have no web version.
import { alternates, bookUrl, canonical } from '../../../lib/site';
import { contentsLabel } from '../../../data/works';

const target = bookUrl('sl', 'contents');
const label = contentsLabel('sl');
const alternateLinks = alternates('book', 'index');
---
<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical(target)} />
    {alternateLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={entry.url} />
    ))}
    <title>{label}</title>
  </head>
  <body>
    <p><a href={target}>{label}</a></p>
  </body>
</html>
