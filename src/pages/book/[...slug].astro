---
// German book: /book/01.html ... (and /book/ for the cover entry).
import { getCollection } from 'astro:content';
import BookLayout from '../../layouts/BookLayout.astro';
import MdxContent from '../../components/MdxContent.astro';
import { WEB_EXCLUDED_FILES } from '../../data/works';
import { bookUrl } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('book');
  return entries
    .filter((entry) => entry.id.startsWith('de/'))
    .map((entry) => entry.id.slice(3))
    .filter((slug) => !WEB_EXCLUDED_FILES.includes(slug))
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const file = slug ?? 'index';
const entries = await getCollection('book');
const entry = entries.find((item) => item.id === (file === 'index' ? 'de' : `de/${file}`));
if (!entry) throw new Error(`Missing German chapter: ${file}`);
const url = file === 'index' ? bookUrl('de', 'index') : bookUrl('de', file);
---
<BookLayout
  lang="de"
  file={file}
  title={entry.data.title}
  description={entry.data.description}
  layout={entry.data.template}
  currentUrl={url}
>
  <MdxContent entry={entry} />
</BookLayout>
