---
// German book: /book/de/01.html ... The contents page is virtual (no MDX
// source file); its title comes from the book catalogue.
import { getCollection } from 'astro:content';
import BookLayout from '../../../layouts/BookLayout.astro';
import MdxContent from '../../../components/MdxContent.astro';
import { WEB_EXCLUDED_FILES, contentsLabel } from '../../../data/works';
import { bookUrl } from '../../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('book');
  const slugs = entries
    .filter((entry) => entry.id.startsWith('de/'))
    .map((entry) => entry.id.slice(3))
    .filter((slug) => !WEB_EXCLUDED_FILES.includes(slug))
    .map((slug) => ({ params: { slug } }));
  return [...slugs, { params: { slug: 'contents' } }];
}

const { slug } = Astro.params;
const file = slug ?? 'contents';
const entries = await getCollection('book');
const entry = file === 'contents'
  ? undefined
  : entries.find((item) => item.id === `de/${file}`);
if (!entry && file !== 'contents') throw new Error(`Missing German chapter: ${file}`);
const title = entry?.data.title ?? contentsLabel('de');
const url = bookUrl('de', file);
---
<BookLayout
  lang="de"
  file={file}
  title={title}
  description={entry?.data.description}
  layout={entry?.data.template ?? 'contents'}
  currentUrl={url}
>
  {entry && <MdxContent entry={entry} />}
</BookLayout>
