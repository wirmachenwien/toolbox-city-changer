---
// Legacy English home (/en/): English is now the default language at /,
// so this page redirects there.
import { alternates, canonical, pageUrl } from '../../lib/site';

const target = pageUrl('en', 'index');
const alternateLinks = alternates('page', 'index');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical(target)} />
    {alternateLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={canonical(entry.url)} />
    ))}
    <title>Home</title>
  </head>
  <body>
    <p><a href={target}>Home</a></p>
  </body>
</html>
