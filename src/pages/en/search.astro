---
// Legacy English search (/en/search.html): redirects to /search.html.
import { alternates, canonical, pageUrl } from '../../lib/site';

const target = pageUrl('en', 'search');
const alternateLinks = alternates('page', 'search');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical(target)} />
    {alternateLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={canonical(entry.url)} />
    ))}
    <title>Search</title>
  </head>
  <body>
    <p><a href={target}>Search</a></p>
  </body>
</html>
