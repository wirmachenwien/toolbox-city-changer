{
  "name": "toolbox-city-changer",
  "type": "module",
  "version": "3.0.0",
  "description": "Toolbox for City Changers handbook site (Astro, static)",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:downloads && node scripts/bin/fix-dist.mjs && npm run build:search",
    "build:downloads": "node scripts/bin/build-downloads.mjs",
    "build:pdf": "python3 scripts/bin/build-pdf.py --all",
    "build:epub": "python3 scripts/bin/build-epub.py --all",
    "build:search": "pagefind --site dist --root-selector 'main[data-pagefind-body]'",
    "preview": "astro preview",
    "astro": "astro",
    "sync:config": "node scripts/bin/sync-config.mjs",
    "check:config": "node scripts/bin/sync-config.mjs --check",
    "check:site": "node scripts/bin/check-site.mjs",
    "check:glossary": "node scripts/bin/check-glossary.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "astro": "^7.3.6",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.3",
    "@types/qrcode": "^1.5.6",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
